<?xml version="1.0"?>
<robot name="space_rover" xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    Complete CAD visual controls. The STL is exported in millimetres and uses
    -X as forward, so the default transform scales, centers, and rotates it
    into the base_link REP-103 frame. Override these xacro arguments when
    refining alignment without editing individual link visuals.
  -->
  <xacro:arg name="use_rover_stl_visual" default="true"/>
  <xacro:arg name="rover_mesh_scale" default="0.001 0.001 0.001"/>
  <xacro:arg name="rover_mesh_xyz" default="0.00875 0 -0.09269867"/>
  <xacro:arg name="rover_mesh_rpy" default="0 0 3.14159265359"/>
  <xacro:property
    name="use_rover_stl_visual"
    value="$(arg use_rover_stl_visual)"/>
  <xacro:property name="rover_mesh_scale" value="$(arg rover_mesh_scale)"/>
  <xacro:property name="rover_mesh_xyz" value="$(arg rover_mesh_xyz)"/>
  <xacro:property name="rover_mesh_rpy" value="$(arg rover_mesh_rpy)"/>

  <xacro:property name="base_length" value="0.32"/>
  <xacro:property name="base_width" value="0.26"/>
  <xacro:property name="base_height" value="0.10"/>
  <!-- Dimensions and axle centers measured from the complete CAD STL. -->
  <xacro:property name="wheel_radius" value="0.070"/>
  <xacro:property name="wheel_width" value="0.040"/>
  <xacro:property name="front_wheel_x" value="0.08375"/>
  <xacro:property name="rear_wheel_x" value="-0.06625"/>
  <xacro:property name="wheel_y" value="0.11650"/>
  <xacro:property name="wheel_z" value="-0.06400"/>

  <material name="chassis_dark"><color rgba="0.10 0.12 0.14 1.0"/></material>
  <material name="wheel_gray"><color rgba="0.35 0.38 0.40 1.0"/></material>
  <material name="camera_blue"><color rgba="0.10 0.25 0.80 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius - wheel_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:if value="${use_rover_stl_visual}">
      <visual name="rover_complete_stl_visual">
        <origin xyz="${rover_mesh_xyz}" rpy="${rover_mesh_rpy}"/>
        <geometry>
          <mesh
            filename="package://space_description/meshes/rover/rover_prototype.stl"
            scale="${rover_mesh_scale}"/>
        </geometry>
        <material name="chassis_dark"/>
      </visual>
    </xacro:if>
    <xacro:unless value="${use_rover_stl_visual}">
      <visual name="primitive_chassis_visual">
        <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
        <material name="chassis_dark"/>
      </visual>
    </xacro:unless>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.8"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.018" ixy="0" ixz="0" iyy="0.022" iyz="0" izz="0.030"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix x y mesh_file">
    <link name="${prefix}_wheel">
      <xacro:if value="${use_rover_stl_visual}">
        <visual name="${prefix}_cad_wheel_visual">
          <!-- Centered wheel STL uses the same millimetre scale and -X-forward
               CAD orientation as the complete rover assembly. -->
          <origin xyz="0 0 0" rpy="0 0 3.14159265359"/>
          <geometry>
            <mesh
              filename="package://space_description/meshes/rover/${mesh_file}"
              scale="${rover_mesh_scale}"/>
          </geometry>
          <material name="wheel_gray"/>
        </visual>
      </xacro:if>
      <xacro:unless value="${use_rover_stl_visual}">
        <visual name="${prefix}_primitive_wheel_visual">
          <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
          <material name="wheel_gray"/>
        </visual>
      </xacro:unless>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.14"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00045" ixy="0" ixz="0" iyy="0.00045" iyz="0" izz="0.00045"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel
    prefix="left_front"
    x="${front_wheel_x}"
    y="${wheel_y}"
    mesh_file="left_front_wheel.stl"/>
  <xacro:wheel
    prefix="left_rear"
    x="${rear_wheel_x}"
    y="${wheel_y}"
    mesh_file="left_rear_wheel.stl"/>
  <xacro:wheel
    prefix="right_front"
    x="${front_wheel_x}"
    y="-${wheel_y}"
    mesh_file="right_front_wheel.stl"/>
  <xacro:wheel
    prefix="right_rear"
    x="${rear_wheel_x}"
    y="-${wheel_y}"
    mesh_file="right_rear_wheel.stl"/>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.055 0.025 0.025"/></geometry>
      <material name="camera_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.055 0.025 0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.17 0 0.07" rpy="0 0 0"/>
  </joint>

  <!-- REP-103 optical coordinates: Z forward, X right, Y down. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>
</robot>
