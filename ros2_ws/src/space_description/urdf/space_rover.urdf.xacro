<?xml version="1.0"?>
<robot name="space_rover" xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    Complete CAD visual controls. The STL is exported in millimetres and uses
    -X as forward, so the default transform scales, centers, and rotates it
    into the base_link REP-103 frame. Override these xacro arguments when
    refining alignment without editing individual link visuals.
  -->
  <xacro:arg name="use_rover_stl_visual" default="true"/>
  <xacro:arg name="rover_mesh_scale" default="0.001 0.001 0.001"/>
  <xacro:arg name="rover_mesh_xyz" default="0.00875 0 -0.09269867"/>
  <xacro:arg name="rover_mesh_rpy" default="0 0 3.14159265359"/>
  <xacro:property
    name="use_rover_stl_visual"
    value="$(arg use_rover_stl_visual)"/>
  <xacro:property name="rover_mesh_scale" value="$(arg rover_mesh_scale)"/>
  <xacro:property name="rover_mesh_xyz" value="$(arg rover_mesh_xyz)"/>
  <xacro:property name="rover_mesh_rpy" value="$(arg rover_mesh_rpy)"/>

  <!--
    Dimensions come from config/rover_geometry.yaml, the single source of truth,
    and are NOT written here. The last CAD import silently invalidated four
    values across four packages because each had its own copy of the wheel
    radius; this file consumes the source instead of duplicating it. To change a
    dimension, edit that YAML.
  -->
  <xacro:property
    name="geom"
    value="${xacro.load_yaml('$(find space_description)/config/rover_geometry.yaml')}"/>
  <xacro:property name="wheel_radius" value="${geom['wheel_radius']}"/>
  <xacro:property name="wheel_width" value="${geom['wheel_width']}"/>
  <xacro:property name="front_wheel_x" value="${geom['front_wheel_x']}"/>
  <xacro:property name="rear_wheel_x" value="${geom['rear_wheel_x']}"/>
  <xacro:property name="wheel_y" value="${geom['wheel_y']}"/>
  <xacro:property name="wheel_z" value="${geom['wheel_z']}"/>

  <!--
    Chassis collision box, derived from the measured mesh extents. It replaces a
    0.32 x 0.26 x 0.10 box that was 15 mm too long and 13 mm too NARROW.
    Over-size is merely conservative; under-size lets Gazebo pass the rover
    through gaps it would physically hit. Vertically it spans the measured
    ground clearance to the chassis top rather than the full mesh bbox, because
    the mesh dips 8 mm below the contact plane at the wheel hubs and a box that
    deep would rest the rover on its chassis instead of its wheels.
  -->
  <xacro:property name="chassis_box_length"
    value="${geom['chassis_max_x'] - geom['chassis_min_x']}"/>
  <xacro:property name="chassis_box_width"
    value="${2 * geom['chassis_half_y']}"/>
  <xacro:property name="chassis_box_height"
    value="${geom['chassis_top_z'] - geom['chassis_ground_clearance']}"/>
  <xacro:property name="chassis_box_x"
    value="${(geom['chassis_min_x'] + geom['chassis_max_x']) / 2}"/>
  <!-- base_link sits wheel_radius - wheel_z above the contact plane. -->
  <xacro:property name="chassis_box_z"
    value="${(geom['chassis_ground_clearance'] + geom['chassis_top_z']) / 2
             - (geom['wheel_radius'] - geom['wheel_z'])}"/>

  <!--
    mass_base is the REMAINDER of mass_total after the wheels, camera, and IMU,
    so the parts can never drift from the total the way they did before: the URDF
    summed to 2.450 kg against a 2.725 kg design estimate. Inertia scales with
    that derived mass instead of being a fixed triple describing the old 1.8 kg
    chassis.
  -->
  <xacro:property name="mass_wheel" value="${geom['mass_wheel']}"/>
  <xacro:property name="mass_camera" value="${geom['mass_camera']}"/>
  <xacro:property name="mass_imu" value="${geom['mass_imu']}"/>
  <xacro:property name="mass_base"
    value="${geom['mass_total'] - 4 * geom['mass_wheel']
             - geom['mass_camera'] - geom['mass_imu']}"/>
  <xacro:property name="base_ixx"
    value="${geom['base_inertia_per_kg']['ixx'] * mass_base}"/>
  <xacro:property name="base_iyy"
    value="${geom['base_inertia_per_kg']['iyy'] * mass_base}"/>
  <xacro:property name="base_izz"
    value="${geom['base_inertia_per_kg']['izz'] * mass_base}"/>

  <material name="chassis_dark"><color rgba="0.10 0.12 0.14 1.0"/></material>
  <material name="wheel_gray"><color rgba="0.35 0.38 0.40 1.0"/></material>
  <material name="camera_blue"><color rgba="0.10 0.25 0.80 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius - wheel_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:if value="${use_rover_stl_visual}">
      <visual name="rover_complete_stl_visual">
        <origin xyz="${rover_mesh_xyz}" rpy="${rover_mesh_rpy}"/>
        <geometry>
          <mesh
            filename="package://space_description/meshes/rover/rover_prototype.stl"
            scale="${rover_mesh_scale}"/>
        </geometry>
        <material name="chassis_dark"/>
      </visual>
    </xacro:if>
    <xacro:unless value="${use_rover_stl_visual}">
      <visual name="primitive_chassis_visual">
        <origin xyz="${chassis_box_x} 0 ${chassis_box_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_box_length} ${chassis_box_width} ${chassis_box_height}"/>
        </geometry>
        <material name="chassis_dark"/>
      </visual>
    </xacro:unless>
    <collision>
      <origin xyz="${chassis_box_x} 0 ${chassis_box_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_box_length} ${chassis_box_width} ${chassis_box_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${mass_base}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${base_ixx}" ixy="0" ixz="0" iyy="${base_iyy}" iyz="0"
        izz="${base_izz}"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix x y mesh_file">
    <link name="${prefix}_wheel">
      <xacro:if value="${use_rover_stl_visual}">
        <visual name="${prefix}_cad_wheel_visual">
          <!-- Centered wheel STL uses the same millimetre scale and -X-forward
               CAD orientation as the complete rover assembly. -->
          <origin xyz="0 0 0" rpy="0 0 3.14159265359"/>
          <geometry>
            <mesh
              filename="package://space_description/meshes/rover/${mesh_file}"
              scale="${rover_mesh_scale}"/>
          </geometry>
          <material name="wheel_gray"/>
        </visual>
      </xacro:if>
      <xacro:unless value="${use_rover_stl_visual}">
        <visual name="${prefix}_primitive_wheel_visual">
          <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
          <material name="wheel_gray"/>
        </visual>
      </xacro:unless>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${mass_wheel}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00045" ixy="0" ixz="0" iyy="0.00045" iyz="0" izz="0.00045"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel
    prefix="left_front"
    x="${front_wheel_x}"
    y="${wheel_y}"
    mesh_file="left_front_wheel.stl"/>
  <xacro:wheel
    prefix="left_rear"
    x="${rear_wheel_x}"
    y="${wheel_y}"
    mesh_file="left_rear_wheel.stl"/>
  <xacro:wheel
    prefix="right_front"
    x="${front_wheel_x}"
    y="-${wheel_y}"
    mesh_file="right_front_wheel.stl"/>
  <xacro:wheel
    prefix="right_rear"
    x="${rear_wheel_x}"
    y="-${wheel_y}"
    mesh_file="right_rear_wheel.stl"/>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.055 0.025 0.025"/></geometry>
      <material name="camera_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.055 0.025 0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="${mass_camera}"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.17 0 0.07" rpy="0 0 0"/>
  </joint>

  <!-- REP-103 optical coordinates: Z forward, X right, Y down. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="${mass_imu}"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>
</robot>
