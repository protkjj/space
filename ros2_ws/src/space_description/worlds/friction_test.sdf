<?xml version="1.0"?>
<sdf version="1.9">
  <world name="friction_test">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.80665</gravity>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <model name="normal_friction_lane">
      <static>true</static>
      <pose>0 0.8 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.9 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.9 0.04</size></box></geometry>
          <material><diffuse>0.38 0.39 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="low_friction_lane">
      <static>true</static>
      <pose>0 -0.8 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.9 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>0.12</mu><mu2>0.08</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.9 0.04</size></box></geometry>
          <material><diffuse>0.88 0.86 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="center_divider">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.05 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.05 0.10</size></box></geometry>
          <material><diffuse>0.15 0.16 0.17 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
