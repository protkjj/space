  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>space_gazebo</exec_depend>
  <exec_depend>space_description</exec_depend>
  <exec_depend>space_controller</exec_depend>
  <exec_depend>space_mission</exec_depend>
