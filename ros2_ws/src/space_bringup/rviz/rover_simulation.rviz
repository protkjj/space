Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 32; 36; 42
    # Gazebo's odom frame is the absolute simulation-world frame. Keeping
    # RViz fixed here prevents SLAM map->odom corrections from moving or
    # tilting the physical arena visualization with the rover.
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Frame Timeout: 15
    - Class: rviz_default_plugins/RobotModel
      Name: Rover
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
    - Class: rviz_default_plugins/Path
      Name: Shortest Global Plan
      Enabled: true
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: false
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /map
    - Class: rviz_default_plugins/Map
      Name: Nav2 Global Costmap
      Enabled: false
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
    - Class: rviz_default_plugins/Marker
      Name: Arena
      Enabled: true
      Topic:
        Value: /arena/visualization_marker
    - Class: rviz_default_plugins/Image
      Name: RGB
      Enabled: true
      Topic:
        Value: /camera/image_raw
    - Class: rviz_default_plugins/Image
      Name: Depth
      Enabled: true
      Max Value: 8
      Median window: 5
      Min Value: 0.1
      Normalize Range: false
      Topic:
        Value: /camera/depth_image_raw
    - Class: rviz_default_plugins/PointCloud2
      Name: Point Cloud
      Enabled: true
      Topic:
        Value: /camera/points
    - Class: rviz_default_plugins/PointCloud2
      Name: Filtered Terrain
      Enabled: true
      Size (Pixels): 3
      Style: Points
      Topic:
        Reliability Policy: Best Effort
        Value: /terrain/filtered_points
    - Class: rviz_default_plugins/PointCloud2
      Name: Elevation Points
      Enabled: true
      Size (Pixels): 5
      Style: Points
      Topic:
        Reliability Policy: Best Effort
        Value: /terrain/elevation_points
    - Class: rviz_default_plugins/MarkerArray
      Name: Elevation Cells
      Enabled: true
      Topic:
        Value: /terrain/elevation_markers
    - Class: rviz_default_plugins/PointCloud2
      Name: Terrain Features
      Enabled: true
      Size (Pixels): 5
      Style: Points
      Topic:
        Reliability Policy: Best Effort
        Value: /terrain/features
    - Class: rviz_default_plugins/MarkerArray
      Name: Terrain Slope
      Enabled: true
      Topic:
        Value: /terrain/slope_markers
    - Class: rviz_default_plugins/MarkerArray
      Name: Terrain Roughness
      Enabled: true
      Topic:
        Value: /terrain/roughness_markers
    - Class: rviz_default_plugins/MarkerArray
      Name: Terrain Step Height
      Enabled: true
      Topic:
        Value: /terrain/step_markers
    - Alpha: 0.8
      Autocompute Intensity Bounds: false
      Channel Name: traversability
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Enabled: true
      Max Color: 0; 255; 0
      Max Intensity: 1
      Min Color: 255; 0; 0
      Min Intensity: 0
      Name: Mission Traversability
      Position Transformer: XYZ
      Size (m): 0.12
      Style: Flat Squares
      Topic:
        Reliability Policy: Best Effort
        Value: /mission/traversability
      Use rainbow: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Perception Traversability Cells
      Enabled: false
      Topic:
        Value: /terrain/traversability_markers
    - Class: rviz_default_plugins/Map
      Name: Nav2 Local Costmap
      Enabled: false
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
    - Class: rviz_default_plugins/Map
      Name: Terrain Layer Debug
      Enabled: false
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /terrain/nav2_costs
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
    - Class: rviz_default_plugins/Polygon
      Name: Rover Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
    - Class: rviz_default_plugins/LaserScan
      Name: Depth Scan
      Enabled: false
      Topic:
        Value: /scan
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Topic: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Target Frame: odom
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 1280
  Height: 800
