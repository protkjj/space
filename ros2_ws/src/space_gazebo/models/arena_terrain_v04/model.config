<?xml version="1.0"?>
<model>
  <name>arena_terrain_v04</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Non-flat competition terrain (arena_terrain_v04). Surface mesh supplied in
    metres by the organising committee. The visual uses the full-resolution
    mesh; collision uses a 0.1 m heightfield resample for physics performance.
  </description>
</model>
