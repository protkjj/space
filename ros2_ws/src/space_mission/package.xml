<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>space_mission</name>
  <version>0.1.0</version>
  <description>Mission-level traversability fusion and orchestration.</description>
  <maintainer email="todo@example.com">space team</maintainer>
  <license>MIT</license>

  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <!-- slip_estimator_node imports space_msgs.msg.SlipEstimate; rover_spec and
       traversability_transform import space_description.rover_geometry and
       numpy. Undeclared dependencies happen to work in a warm workspace and
       fail in a clean one. -->
  <depend>space_msgs</depend>
  <exec_depend>grid_map_msgs</exec_depend>
  <exec_depend>space_description</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
